# Veylora RIP development environment template.
#
# Copy to `.env` (gitignored). This project has no secrets, accounts, cloud
# services, or telemetry (AGENTS.md), so nothing here is sensitive. Only
# variables the toolchain already reads are listed.
#
# Nothing loads this file automatically: cargo ignores it and Vite only reads
# `app/.env`. Load it in your shell, for example:
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '^\s*[^#\s]' } | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
#   Bash:        set -a; source .env; set +a

# Rust: print a backtrace on panic (read by the Rust standard library).
RUST_BACKTRACE=1

# Cargo: keep colored output when piping through other tools (read by cargo).
CARGO_TERM_COLOR=always
