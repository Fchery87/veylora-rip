{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veylora RIP",
  "version": "0.0.0",
  "identifier": "app.veylora.rip",
  "build": {
    "beforeDevCommand": {
      "script": "npx pnpm@12.18.0 dev",
      "cwd": "../../app",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npx pnpm@12.18.0 build",
      "cwd": "../../app",
      "wait": true
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veylora RIP",
        "width": 1366,
        "height": 768,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
