{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veylora RIP",
  "version": "0.0.0",
  "identifier": "app.veylora.rip",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../app dev",
    "beforeBuildCommand": "pnpm --dir ../../app build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veylora RIP",
        "width": 1366,
        "height": 768,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
